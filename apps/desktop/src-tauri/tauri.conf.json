{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkillHub",
  "version": "0.1.0",
  "identifier": "com.skillhub.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir apps/desktop dev",
    "beforeBuildCommand": "pnpm --dir apps/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SkillHub",
        "width": 1100,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
