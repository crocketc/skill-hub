{
  "id": "basic-v1",
  "rules": [
    { "code": "security.destructive_command", "severity": "critical", "category": "destructive", "product_level": "danger" },
    { "code": "security.elevation", "severity": "error", "category": "privilege", "product_level": "danger" },
    { "code": "security.permission_change", "severity": "error", "category": "privilege", "product_level": "danger" },
    { "code": "security.persistence", "severity": "error", "category": "persistence", "product_level": "danger" },
    { "code": "security.download_and_execute", "severity": "critical", "category": "execution", "product_level": "danger" },
    { "code": "security.data_upload", "severity": "error", "category": "exfiltration", "product_level": "danger" },
    { "code": "security.command_interpolation", "severity": "warning", "category": "execution", "product_level": "warning" },
    { "code": "security.obfuscation", "severity": "warning", "category": "obfuscation", "product_level": "warning" },
    { "code": "security.path_traversal", "severity": "error", "category": "filesystem", "product_level": "danger" },
    { "code": "security.possible_plaintext_credential", "severity": "warning", "category": "credential", "product_level": "warning" },
    { "code": "security.prompt_injection", "severity": "warning", "category": "prompt_injection", "product_level": "warning" },
    { "code": "security.suspicious_external_resource", "severity": "warning", "category": "external_resource", "product_level": "warning" }
  ]
}
